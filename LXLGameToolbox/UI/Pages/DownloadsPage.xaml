<UserControl x:Class="LXLGameToolbox.UI.Pages.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="下载中心" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="所有下载与更新都在后台进行，可以随时切换到其它页面，进度会继续保留"
                               Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButton}" Content="打开下载目录" Padding="14,7"
                            Click="OpenFolder_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="清理已完成" Padding="14,7"
                            Margin="8,0,0,0" Click="Clear_Click"/>
                </StackPanel>
            </Grid>

            <Border x:Name="EmptyPanel" Style="{StaticResource FlatCard}" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="当前没有下载任务" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="在工具箱里点击「下载并安装」或「更新」，下载会转到后台，在这里可以看到实时进度。"
                               FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="TaskList" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentLightBrush}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Version}" FontSize="10"
                                                       Foreground="{DynamicResource AccentTextBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding PercentText}" FontSize="11" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="取消" Padding="10,4"
                                                Visibility="{Binding CancelVisibility}" Click="Cancel_Click"/>
                                        <Button Style="{StaticResource OutlineButton}" Content="运行安装程序" Padding="12,5"
                                                Margin="8,0,0,0" Visibility="{Binding InstallerVisibility}"
                                                Click="OpenInstaller_Click"/>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Style="{StaticResource PclProgressBar}" Maximum="100" Margin="0,12,0,0"
                                             Value="{Binding Percent, Mode=OneWay}"
                                             Visibility="{Binding RunningVisibility}"/>
                                <TextBlock Text="{Binding StageText}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding DetailText}" FontSize="11" Margin="0,5,0,0"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="提示：下载完成后第三方软件会自动启动安装向导；自制工具会直接解压安装并刷新卡片状态。"
                       Style="{StaticResource HintText}" Margin="0,4,0,8" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
