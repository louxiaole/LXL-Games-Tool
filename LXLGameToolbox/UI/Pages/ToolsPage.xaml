<UserControl x:Class="LXLGameToolbox.UI.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="游戏工具箱" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="小乐自制工具与第三方游戏修改器分专区管理：下载、安装、更新、启动一站式完成"
                       Style="{StaticResource HintText}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 搜索与操作 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid HorizontalAlignment="Left" Width="320">
                <TextBox x:Name="SearchBox" Style="{StaticResource PclTextBox}" TextChanged="SearchBox_TextChanged"
                         ToolTip="按名称、分类、提供方搜索"/>
                <TextBlock x:Name="SearchPlaceholder" Text="搜索工具名称或分类" IsHitTestVisible="False"
                           Margin="13,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ScanButton" Style="{StaticResource OutlineButton}" Content="扫描本地"
                        Click="Scan_Click" Padding="14,7"/>
                <Button x:Name="UpdateAllButton" Style="{StaticResource SoftButton}" Content="一键更新"
                        Click="UpdateAll_Click" Padding="14,7" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 专区分组 -->
        <WrapPanel x:Name="ZonePanel" Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"/>

        <!-- 分类筛选 -->
        <WrapPanel x:Name="CategoryPanel" Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,2"/>

        <!-- 工具列表（按专区自动分组） -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,2,0,0">
            <ItemsControl x:Name="ToolList">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,12,0,10" Margin="0,0,8,10"
                                        ToolTip="{Binding Items[0].ZoneDescription}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="18" CornerRadius="2"
                                                Background="{Binding Items[0].ZoneBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                        Background="{DynamicResource AccentLighterBrush}">
                                                    <TextBlock Text="{Binding ItemCount}" FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Items[0].ZoneDescription}" FontSize="11"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="{Binding IconBackground}"
                                        VerticalAlignment="Top" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding IconImage}" Visibility="{Binding IconVisibility}"
                                               Stretch="Uniform" Margin="2"/>
                                        <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="17"
                                                   FontWeight="Bold" Visibility="{Binding GlyphVisibility}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource Badge}" Background="{Binding StatusBackground}"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                       Foreground="{Binding StatusBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Category}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="·" FontSize="11" Margin="8,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding VersionText}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="·" FontSize="11" Margin="8,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}"
                                            Padding="14,7" MinWidth="92" Click="CardPrimary_Click"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="{Binding UpdateText}"
                                            Padding="14,5" MinWidth="92" Margin="0,4,0,0"
                                            Click="CardUpdate_Click"
                                            Visibility="{Binding UpdateVisibility}"
                                            ToolTip="下载最新版本并更新本机安装"/>
                                    <Button Style="{StaticResource GhostButton}" Content="详情"
                                            Margin="0,4,0,0" Click="CardDetail_Click"/>
                                    <Button Style="{StaticResource DangerButton}" Content="卸载"
                                            Padding="14,5" MinWidth="92" Margin="0,4,0,0"
                                            Click="CardUninstall_Click"
                                            Visibility="{Binding UninstallVisibility}"
                                            ToolTip="卸载或移除本机已安装的程序"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="62,10,0,0"
                                            Visibility="{Binding BusyVisibility}">
                                    <ProgressBar Style="{StaticResource PclProgressBar}"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Maximum="100"/>
                                    <TextBlock Text="{Binding BusyText}" FontSize="11" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部统计 -->
        <TextBlock x:Name="SummaryText" Grid.Row="5" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
