<Window x:Class="LXLGameToolbox.UI.Windows.ToolDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="工具详情" Width="760" Height="680" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource OpaqueBackgroundBrush}" Icon="/Assets/lxl.ico"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceGlassBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentGradientBrush}">
                    <TextBlock Text="LX" Foreground="White" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="工具详情" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;"
                    Click="CloseButton_Click" ToolTip="关闭"/>
        </Grid>

        <!-- 详情内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,4,24,18">

                <Border Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="IconBorder" Width="56" Height="56" CornerRadius="14" VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="IconImage" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                                <TextBlock x:Name="GlyphText" Text="LX" Foreground="White" FontSize="20"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NameText" Text="工具名称" FontSize="19" FontWeight="SemiBold"/>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentLightBrush}"
                                        Margin="10,0,0,0">
                                    <TextBlock x:Name="CategoryText" Text="分类" FontSize="10"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                                <Border x:Name="ZoneBadge" Style="{StaticResource Badge}"
                                        Background="{DynamicResource AccentLighterBrush}" Margin="8,0,0,0">
                                    <TextBlock x:Name="ZoneText" Text="专区" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DescriptionText" Text="工具介绍" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       LineHeight="19"/>
                            <TextBlock x:Name="RepoText" Text="仓库地址" FontSize="11" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FlatCard}" Padding="18" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="最新版本" Style="{StaticResource CaptionText}" Margin="0,0,0,9"/>
                        <TextBlock x:Name="LatestVersionText" Grid.Column="1" Text="获取中 ..." FontSize="12"
                                   Margin="0,0,0,9" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Text="本地版本" Style="{StaticResource CaptionText}" Margin="0,0,0,9"/>
                        <TextBlock x:Name="LocalVersionText" Grid.Row="1" Grid.Column="1" Text="未安装" FontSize="12"
                                   Margin="0,0,0,9"/>

                        <TextBlock Grid.Row="2" Text="来源" Style="{StaticResource CaptionText}" Margin="0,0,0,9"/>
                        <TextBlock x:Name="SourceText" Grid.Row="2" Grid.Column="1" Text="—" FontSize="12"
                                   Margin="0,0,0,9"/>

                        <TextBlock Grid.Row="3" Text="安装位置" Style="{StaticResource CaptionText}" Margin="0,0,0,9"/>
                        <TextBlock x:Name="PathText" Grid.Row="3" Grid.Column="1" Text="—" FontSize="12"
                                   Margin="0,0,0,9" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4" Text="安装包大小" Style="{StaticResource CaptionText}" Margin="0,0,0,9"/>
                        <TextBlock x:Name="SizeText" Grid.Row="4" Grid.Column="1" Text="—" FontSize="12"
                                   Margin="0,0,0,9"/>

                        <TextBlock Grid.Row="5" Text="发布时间" Style="{StaticResource CaptionText}"/>
                        <TextBlock x:Name="DateText" Grid.Row="5" Grid.Column="1" Text="—" FontSize="12"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FlatCard}" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ChangelogTitle" Text="更新说明" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock x:Name="ChangelogText" Text="正在获取 ..." FontSize="12" TextWrapping="Wrap"
                                   Margin="0,10,0,0" LineHeight="20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作区：进度与按钮常驻可见 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceGlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Margin="24,14,24,16">

                <Border x:Name="ProgressPanel" Style="{StaticResource FlatCard}" Padding="16"
                        Visibility="Collapsed" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressTitle" Text="正在下载 ..." FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="取消" Padding="8,3" Click="Cancel_Click"/>
                        </Grid>
                        <ProgressBar x:Name="DownloadBar" Style="{StaticResource PclProgressBar}" Maximum="100"
                                     Value="0" Margin="0,10,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressInfo" Text="" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="打开下载目录"
                                    FontSize="11" Click="OpenDownload_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Content="下载并安装"
                            Padding="22,9" MinWidth="128" Margin="0,0,8,0" Click="Action_Click"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource OutlineButton}" Content="更新"
                            Padding="18,8" Margin="0,0,8,0" Click="Update_Click" Visibility="Collapsed"
                            ToolTip="下载最新版本并更新本机安装"/>
                    <Button x:Name="ChooseButton" Style="{StaticResource OutlineButton}" Content="选择本地程序"
                            Padding="16,8" Margin="0,0,8,0" Click="Choose_Click"/>
                    <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Content="打开安装目录"
                            Margin="0,0,8,0" Click="Folder_Click"/>
                    <Button x:Name="MigrateButton" Style="{StaticResource OutlineButton}" Content="迁移到其他目录"
                            Margin="0,0,8,0" Click="Migrate_Click" Visibility="Collapsed"
                            ToolTip="把已安装的程序文件移动到其他目录"/>
                    <Button x:Name="ReinstallButton" Style="{StaticResource GhostButton}" Content="重装最新版"
                            Margin="0,0,8,0" Click="Reinstall_Click" Visibility="Collapsed"/>
                    <Button x:Name="UninstallButton" Style="{StaticResource DangerButton}" Content="卸载"
                            Margin="0,0,8,0" Click="Uninstall_Click" Visibility="Collapsed"
                            ToolTip="卸载本机已安装的程序"/>
                    <Button x:Name="RepoButton" Style="{StaticResource GhostButton}" Content="Release 页面"
                            Margin="0,0,8,0" Click="Repo_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
