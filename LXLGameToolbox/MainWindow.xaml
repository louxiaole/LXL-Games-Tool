<Window x:Class="LXLGameToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:LXLGameToolbox.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LXL 游戏工具箱" Width="1150" Height="720" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Icon="Assets/lxl.ico"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 背景层：主题底色 / 动漫壁纸 / 可读性遮罩 -->
        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource WindowBackgroundBrush}"/>
        <Image x:Name="BackgroundImage" Grid.RowSpan="3" Stretch="UniformToFill" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle x:Name="BackgroundScrim" Grid.RowSpan="3" Fill="Transparent" IsHitTestVisible="False"/>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceGlassBrush}" x:Name="TitleBar"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}">
                    <TextBlock Text="LX" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="LXL 游戏工具箱" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentLightBrush}" Margin="8,0,0,0" Padding="6,1">
                    <TextBlock Text="{x:Static core:AppState.VersionText}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>
                <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="14,0,0,0"/>
                <TextBlock Text="小乐自制工具 · 游戏修改器 · 联机工具 · 磁盘工具 · 游戏辅助" Margin="14,0,0,0" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                        Click="MinimizeButton_Click" ToolTip="最小化"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                        Click="MaximizeButton_Click" ToolTip="最大化"/>
                <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;"
                        Click="CloseButton_Click" ToolTip="关闭"/>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Background="{DynamicResource SurfaceGlassBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <RadioButton x:Name="NavTools" Style="{StaticResource SidebarNavButton}" Content="&#xE90F;"
                                 Tag="tools" ToolTip="工具箱" AutomationProperties.Name="工具箱"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDownloads" Style="{StaticResource SidebarNavButton}" Content="&#xE896;"
                                 Tag="downloads" ToolTip="下载中心" AutomationProperties.Name="下载中心"
                                 Checked="Nav_Checked" Margin="0,6,0,0"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource SidebarNavButton}" Content="&#xE81C;"
                                 Tag="log" ToolTip="更新日志" AutomationProperties.Name="更新日志"
                                 Checked="Nav_Checked" Margin="0,6,0,0"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarNavButton}" Content="&#xE713;"
                                 Tag="settings" ToolTip="设置" AutomationProperties.Name="设置"
                                 Checked="Nav_Checked" Margin="0,6,0,0"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource SidebarNavButton}" Content="&#xE946;"
                                 Tag="about" ToolTip="关于" AutomationProperties.Name="关于"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </Border>

            <!-- 页面容器 -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="20,16,20,12" Focusable="False"/>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceGlassBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="LXL 游戏工具箱" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="StatusLeft" Text="就绪" FontSize="11" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Static core:AppState.VersionText}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
